{
  "name": "bend2",
  "displayName": "Bend (2.0) \u2014 Language Server",
  "description": "Bend 2.0 language support powered by the real Bend checker: exact diagnostics, law/proof workflow states. LSP server + syntax.",
  "version": "2.2.0",
  "publisher": "jk2500",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "bend",
    "hvm",
    "higherorderco",
    "laws",
    "proofs",
    "parallel",
    "lsp",
    "language server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jk2500/bend-vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "bend",
        "aliases": [
          "Bend"
        ],
        "extensions": [
          ".bend"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bend",
        "scopeName": "source.bend",
        "path": "./syntaxes/bend.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bend2.check",
        "title": "Bend: check this file now"
      },
      {
        "command": "bend2.restartServer",
        "title": "Bend: restart language server"
      }
    ],
    "configuration": {
      "title": "Bend",
      "properties": {
        "bend2.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use the language server (bun + the real Bend checker). Off = CLI-text fallback."
        }
      }
    }
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:bend"
  ]
}
